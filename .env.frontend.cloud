# Frontend Environment Variables for Cloud Deployment (Hugging Face Spaces)
# INSTRUCTIONS: 
# 1. Create a file named exactly '.env.production' in the project root
# 2. Copy this content into that file
# 3. Replace the API URL with your actual RunPod endpoint
# 4. When you run 'npm run build', React will automatically use .env.production

# ===== Backend API Configuration =====
# This tells the React app where to find the Express API
# Replace with your RunPod endpoint URL after deployment
# Example: https://your-pod-id-12345.runpod.net/api
REACT_APP_API_URL=https://your-runpod-endpoint.runpod.net/api

# ===== Notes =====
# 1. The file MUST be named .env.production (not .env.frontend.cloud)
# 2. React only reads environment variables that start with REACT_APP_
# 3. You need to rebuild the React app (npm run build) after changing this
# 4. The built files in the build/ folder will have this URL baked in
# 5. This is different from the local .env which uses http://localhost:5000/api
