# Cloud Environment Variables Template
# INSTRUCTIONS: Copy this file to .env before deploying to RunPod
# Replace the placeholder values with your actual credentials

# ===== MongoDB Atlas Configuration =====
# Get this from MongoDB Atlas: Clusters -> Connect -> Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/campaign-crm?retryWrites=true&w=majority

# ===== Server Configuration =====
# Port that Express will listen on (RunPod will expose this)
PORT=5000

# Environment mode - use 'production' for cloud deployment
NODE_ENV=production

# ===== Security =====
# Generate a strong random secret for JWT tokens
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-jwt-secret-here

# ===== CORS Configuration =====
# This will be your Hugging Face Space URL where the frontend is hosted
# Example: https://your-username-campaign-crm.hf.space
# Update server/index.js to use this in CORS configuration
FRONTEND_URL=https://your-hf-space-url.hf.space

# ===== Notes =====
# 1. NEVER commit the actual .env file to git (it should be in .gitignore)
# 2. In RunPod, you can set these as environment variables in the pod configuration
# 3. For MongoDB Atlas free tier: Clusters are limited to 512MB storage
# 4. Make sure to whitelist RunPod's IP addresses in MongoDB Atlas Network Access
#    Or use 0.0.0.0/0 to allow all IPs (less secure but simpler for testing)
